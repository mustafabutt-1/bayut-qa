# Bayut QA — environment template.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Nothing in this file is invented: every blank is a value someone must supply.

# ---------------------------------------------------------------------------
# App under test
# ---------------------------------------------------------------------------
BAYUT_APP_PACKAGE=                 # e.g. from: adb shell pm list packages | grep -i bayut
BAYUT_APP_ACTIVITY=                # from: adb shell dumpsys window | grep mCurrentFocus
BAYUT_APK_PATH=                    # local path to the build under test (.apk / .aab-derived apk)
BAYUT_BUILD_VERSION=               # versionName of the build under test, recorded into every report
BAYUT_DEEPLINK_SCHEME=             # e.g. bayut  — UNKNOWN until verified
BAYUT_WEB_BASE_URL=                # base URL used for App Links / cross-checking in a browser

# ---------------------------------------------------------------------------
# Environment under test
# ---------------------------------------------------------------------------
TEST_ENVIRONMENT=production        # PRODUCTION until told otherwise. Read docs/GUARDRAILS.md
                                   # before changing this to staging.
API_BASE_HOST=                     # host observed in mitmproxy captures; used to filter HAR entries

# ---------------------------------------------------------------------------
# Appium
# ---------------------------------------------------------------------------
APPIUM_SERVER_URL=http://127.0.0.1:4723
APPIUM_AUTOMATION_NAME=UiAutomator2
APPIUM_NEW_COMMAND_TIMEOUT=120
APPIUM_IMPLICIT_WAIT=0             # keep at 0 — explicit waits only, per CLAUDE.md
DEFAULT_EXPLICIT_WAIT=15           # seconds

# ---------------------------------------------------------------------------
# Devices (serials from `adb devices -l`)
# ---------------------------------------------------------------------------
# DEVICE_D1_SERIAL is OPTIONAL — tests/conftest.py auto-picks the one connected
# device via tools/adb.py's Adb.require_device(). Only set this to disambiguate when
# several devices are attached at once; leave blank otherwise (docs/DECISIONS.md D-030).
DEVICE_D1_SERIAL=                  # T1 primary, EN
DEVICE_D2_SERIAL=                  # T1 primary, AR
DEVICE_D3_SERIAL=                  # T2 low-end / oldest supported API
DEVICE_D4_SERIAL=                  # T2 large screen / newest API

# ---------------------------------------------------------------------------
# Testmo
# ---------------------------------------------------------------------------
TESTMO_BASE_URL=                   # e.g. https://<your-instance>.testmo.net
TESTMO_API_TOKEN=                  # personal API token — never commit
TESTMO_PROJECT_ID=
TESTMO_DRAFT_SUITE_ID=             # suite that agent-generated cases land in as DRAFTS

# ---------------------------------------------------------------------------
# ClickUp  (READ-ONLY — duplicate detection only, by design)
# ---------------------------------------------------------------------------
CLICKUP_API_TOKEN=                 # a read-scoped token if your plan supports it
CLICKUP_TEAM_ID=
CLICKUP_DEFECT_LIST_ID=            # list searched for duplicates

# ---------------------------------------------------------------------------
# mitmproxy (API oracle + fault injection)
# ---------------------------------------------------------------------------
MITM_HOST=                         # IP of the machine running mitmproxy, reachable from the device
MITM_PORT=8080
MITM_ENABLED=false                 # opt-in per run; the proxy fixture is not default-on

# ---------------------------------------------------------------------------
# Test accounts  (use dedicated QA accounts, never a real user's)
# ---------------------------------------------------------------------------
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_PHONE=                   # for OTP / lead flows; must be a number we control

# Named accounts from docs/REGRESSION-CHECKLIST.md — redacted out of that file per
# the "never inline an account" rule. Fill in from the source PDF / QA team.
TEST_ACCOUNT_PORTFOLIO_EMAIL=      # Leads Verification test portfolio account; reused in Find My Agent
TEST_ACCOUNT_PORTFOLIO_PASSWORD=
TEST_ACCOUNT_ADMIN1_EMAIL=         # Admin Claims — "...+agent@sectorlabs.ro"
TEST_ACCOUNT_ADMIN1_PASSWORD=
TEST_ACCOUNT_ADMIN2_EMAIL=         # Admin Claims — "...+trubrokeragent@sectorlabs.ro"
TEST_ACCOUNT_ADMIN2_PASSWORD=
TEST_ACCOUNT_AGENT1_EMAIL=         # Admin Claims — "...+slmihaie2e@sectorlabs.ro"
TEST_ACCOUNT_AGENT1_PASSWORD=
TEST_ACCOUNT_AGENT2_EMAIL=         # Admin Claims — "...+slbogdane2e@sectorlabs.ro"
TEST_ACCOUNT_AGENT2_PASSWORD=
TEST_ACCOUNT_AGENT_FMA_EMAIL=      # Find My Agent — "Automation+agent@sectorlabs.ro"
TEST_ACCOUNT_AGENT_FMA_PASSWORD=   # NOTE: source doc gives a different password for this
                                    # email than TEST_ACCOUNT_ADMIN1_PASSWORD despite the
                                    # near-identical address — unresolved, verify before use

# Lead-test fixtures. These mirror LEAD_TEST_AGENCIES / LEAD_TEST_LOCATION in
# tools/crawl_safety.py and must stay in sync — changing them changes what the safety
# guard will permit. See docs/GUARDRAILS.md.
LEAD_TEST_AGENCY=Explorer Real Estate
LEAD_TEST_LOCATION=Al Napoca

# ---------------------------------------------------------------------------
# Artifacts
# ---------------------------------------------------------------------------
RUNS_DIR=runs
REPORTS_DIR=reports
VIDEO_CAPTURE=on_failure           # always | on_failure | never
LOGCAT_WINDOW_SECONDS=60           # trim window around a failure, used by evidence.py
